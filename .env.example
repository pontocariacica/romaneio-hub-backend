# Copie para .env e ajuste. NUNCA versione o .env com segredos reais.

# Domínios autorizados a chamar a API (separados por vírgula).
# Ex.: https://seu-app.com,https://outro.com   (use * só em teste)
ALLOWED_ORIGINS=*

# Limites de segurança
MAX_MB=50
MAX_PAGES=1500
TIMEOUT_SECONDS=120

# OCR no servidor (requer tesseract instalado - já vem no Dockerfile)
OCR_ENABLED=false

# Porta (a maioria das plataformas define automaticamente)
PORT=8000
